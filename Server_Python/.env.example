# Environment
APP_ENV=production
API_HOST=0.0.0.0
# Single Python HTTP port per node: it serves BOTH external clients
# (auth/users/chain/...) AND the co-located Elixir engine (python_call),
# routed by URL path. Elixir itself listens on 4000 (cluster gossip) and
# 600x (internal HTTP for simbehaviour forwarding), so nothing collides even
# though both halves share the node's IP. Host-side uniqueness comes from
# the published ports (deploy.sh maps 8001..8004 / 4001..4004 / 6001..6004).
API_PORT=8000
DB_PATH=/data/bis.db

# Security
# Generate a long random value (at least 32 bytes, base64/url-safe)
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Node identity: both for server-like interaction with client and node-like BFT validator
NODE_ID=node_1
NODE_PRIVATE_KEY=CHANGE_ME_VALIDATOR_PRIVATE_KEY
# trusted validators public keys (JSON object, base64 Ed25519 keys)
NODE_PUBLIC_KEYS={"node_1":"BASE64_PUBLIC_KEY_1","node_2":"BASE64_PUBLIC_KEY_2","node_3":"BASE64_PUBLIC_KEY_3","node_4":"BASE64_PUBLIC_KEY_4"}

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# auto | ssl | starttls | none
SMTP_SECURITY=ssl
SMTP_USER=matteo.cancian@samuel-daros.it
SMTP_PASS=Matteo_03
SMTP_FROM=no-reply@distributed.bis.it

# Initial admin bootstrap
INITIAL_ADMIN_NAME=System
INITIAL_ADMIN_SURNAME=Admin
INITIAL_ADMIN_EMAIL=cancian2003@gmail.com
INITIAL_ADMIN_PASSWORD=Matteo_03

# Security alerts and reset policy
SECURITY_ALERT_EMAIL=security@example.com
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS_PER_DAY=10

# Application-level client token shared with frontend
APP_CLIENT_TOKEN=CHANGE_ME_APP_CLIENT_TOKEN

# Co-located Elixir consensus engine (used to forward simbehaviour mode changes).
# The Elixir HTTP listener binds the per-node port below inside its container
# (node_a -> 6001, node_b -> 6002, node_c -> 6003, node_d -> 6004); deploy.sh
# publishes 600x:600x on the host. The Python backend reaches it via
# ELIXIR_HOST (container alias) + ELIXIR_HTTP_PORT, so nothing collides even
# though both halves share the node's IP.
ELIXIR_HOST=localhost
ELIXIR_HTTP_PORT=6001
