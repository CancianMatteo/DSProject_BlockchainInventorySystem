# Configuration read by each Python backend.
# Compose supplies each node ID and the common validator-ID roster.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
DB_PATH=/data/bis.db

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=auto
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

INITIAL_ADMIN_NAME=System
INITIAL_ADMIN_SURNAME=Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SECURITY_ALERT_EMAIL=security@example.com
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS_PER_DAY=10
APP_CLIENT_TOKEN=

ELIXIR_HTTP_PORT=6000
LOG_LEVEL=INFO
