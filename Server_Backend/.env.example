# Environment
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
# Used only by direct backend exposure (without reverse proxy)
API_PUBLIC_PORT=8090
HOST_UID=1000
HOST_GID=1000
DB_PATH=/data/bis.db

# Security
# Generate a long random value (at least 32 bytes, base64/url-safe)
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Server signing keys (base64 encoded values used by the app)
SERVER_SIGN_PRIVATE_KEY=CHANGE_ME_SERVER_SIGN_PRIVATE_KEY
SERVER_SIGN_PUBLIC_KEY=CHANGE_ME_SERVER_SIGN_PUBLIC_KEY

# BFT validator identity and trusted validator public keys (JSON object, base64 Ed25519 keys)
NODE_ID=node_a
VALIDATOR_PRIVATE_KEY=CHANGE_ME_VALIDATOR_PRIVATE_KEY
VALIDATOR_PUBLIC_KEYS={"node_a":"BASE64_PUBLIC_KEY_A","node_b":"BASE64_PUBLIC_KEY_B","node_c":"BASE64_PUBLIC_KEY_C"}

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# auto | ssl | starttls | none
SMTP_SECURITY=ssl
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com

# Initial admin bootstrap
INITIAL_ADMIN_NAME=System
INITIAL_ADMIN_SURNAME=Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Security alerts and reset policy
SECURITY_ALERT_EMAIL=security@example.com
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS_PER_DAY=10

# Application-level client token shared with frontend
APP_CLIENT_TOKEN=CHANGE_ME_APP_CLIENT_TOKEN
